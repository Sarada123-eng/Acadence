DATABASE_URL=postgresql+psycopg://postgres:password@127.0.0.1:5432/acadence
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
STUDENT_ALLOWED_EMAIL_DOMAINS=example.edu
PENDING_REGISTRATION_EXPIRE_MINUTES=30
# Required only when sending email; use an address from a verified Resend domain.
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=Acadence
# Dedicated HMAC secret for student email OTPs; use at least 32 random bytes.
STUDENT_EMAIL_OTP_SECRET=
STUDENT_EMAIL_OTP_EXPIRE_MINUTES=5
STUDENT_EMAIL_OTP_MAX_ATTEMPTS=5
